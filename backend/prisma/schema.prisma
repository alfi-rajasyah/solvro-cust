// Solvro data model — see PRD §6.4 for the conceptual schema.
// Naming: camelCase in TS via Prisma client; snake_case in SQL via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskCategory {
  EXTERNAL
  INTERNAL
  TECHNICAL
  ORGANIZATIONAL
  FINANCIAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

// Network Diagram dependency edges. HARD = solid (true blocking),
// SOFT = dashed (estimated/optional). Per CLAUDE.md the diagram only
// uses these two — no FS/SS/FF/SF lag semantics.
enum DependencyType {
  HARD
  SOFT
}

// Daily Review note visibility. The Internal/Customer-facing toggle is
// removed from the UI; the UI only ever writes INTERNAL. Column and default
// stay so the "INTERNAL notes never appear in exports" guardrail holds.
enum NoteVisibility {
  INTERNAL
  CUSTOMER_FACING
}

enum WeeklyHealth {
  GREEN
  AMBER
  RED
}

enum WeeklyStatus {
  NOT_STARTED
  DRAFT
  DONE
}

model Role {
  id          Int    @id @default(autoincrement())
  roleName    String @unique @map("role_name")
  permissions Json   @default("[]") @db.JsonB
  users       User[]

  @@map("roles")
}

model User {
  id                     Int                   @id @default(autoincrement())
  username               String                @unique
  email                  String                @unique
  // Nullable since Google-provisioned users have no password.
  // POST /auth/login rejects users with a null hash (HTTP 401 "google_only").
  passwordHash           String?               @map("password_hash")
  // Google `sub` claim. Unique per Google identity; null for password-only users.
  googleSub              String?               @unique @map("google_sub")
  avatarUrl              String?               @map("avatar_url")
  roleId                 Int                   @map("role_id")
  role                   Role                  @relation(fields: [roleId], references: [id])
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now()) @map("created_at")
  projectsAsTAM          Project[]             @relation("ProjectTAM")
  projectBaselinesLocked Project[]             @relation("ProjectBaselineLockedBy")
  assignedTasks          Task[]
  epicsOwned             Epic[]
  comments               Comment[]
  projectNotes           ProjectNote[]
  authConfigUpdates      AuthConfig[]          @relation("AuthConfigUpdatedBy")
  tamCustomers           Customer[]            @relation("CustomerTam")
  customerNotes          CustomerNote[]
  weeklyUpdates          WeeklyUpdate[]
  projectReviews         ProjectReview[]
  itopConfigUpdates      ItopConfig[]          @relation("ItopConfigUpdatedBy")
  // iTop Person/User object keys this account is matched to (by email).
  itopPersonId           Int?                  @unique @map("itop_person_id")
  itopUserId             Int?                  @unique @map("itop_user_id")
  itopTimeEntries        ItopTimeEntry[]
  // Personal iTop token (Phase 5 write path, backend/src/routes/itopUser.ts).
  // Sealed at rest (lib/secretBox.ts) — never the plaintext token. Writes to
  // iTop always use this token for the acting user; the application token
  // (ItopConfig.appTokenEnc) is read-only and never used for a write.
  itopTokenEnc           String?               @map("itop_token_enc")
  itopTokenCheckedAt     DateTime?             @map("itop_token_checked_at")
  itopTokenPersonName    String?               @map("itop_token_person_name")
  itopTokenExpiresAt     DateTime?             @map("itop_token_expires_at")
  projectMemberships     ProjectMember[]       @relation("ProjectMemberUser")
  projectMembersAdded    ProjectMember[]       @relation("ProjectMemberAddedBy")

  @@index([roleId])
  @@map("users")
}

// Singleton row (id="default") holding policy that the in-app admin can edit
// without a redeploy. The Google Client ID stays in env (infra-level); the
// allowed-domains list lives here (operational policy).
model AuthConfig {
  id                   String   @id @default("default")
  // Google OAuth 2.0 Client ID. Public — Google verifies ID tokens server-side
  // against this audience. Stored in DB so the admin can configure it from the
  // app (Admin > Sign-in) without a redeploy / rebuild.
  googleClientId       String?  @map("google_client_id")
  googleAllowedDomains String[] @default([]) @map("google_allowed_domains")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedById          Int?     @map("updated_by_id")
  updatedBy            User?    @relation("AuthConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("auth_config")
}

// Singleton row (id="default") holding the iTop connection + sync policy,
// editable by an admin without a redeploy. Copies the AuthConfig singleton
// pattern above. Token fields hold sealed ciphertext (backend/src/lib/secretBox.ts)
// — never the plaintext token — set by a later task.
model ItopConfig {
  id                   String    @id @default("default")
  baseUrl              String?   @map("base_url")
  appTokenEnc          String?   @map("app_token_enc")
  webhookSecretEnc     String?   @map("webhook_secret_enc")
  // IANA timezone name the iTop SERVER is configured with (confirmed on the
  // reference install: 'timezone' => 'Europe/Paris') — iTop's REST API
  // returns/accepts "YYYY-MM-DD HH:MM:SS" wall-clock strings in THIS zone,
  // never UTC and never with an offset suffix. lib/itop/sync.ts's
  // parseItopDate/formatItopDate convert through lib/itop/timezone.ts using
  // this value. Admin-set via PATCH /admin/itop/settings, validated with
  // isValidTimeZone (routes/itopAdmin.ts).
  timezone             String    @default("UTC") @map("timezone")
  refreshMinutes       Int       @default(5) @map("refresh_minutes")
  readClasses          String[]  @default(["UserRequest", "Incident"]) @map("read_classes")
  capacityHoursPerWeek Int       @default(40) @map("capacity_hours_per_week")
  actionsEnabled       Boolean   @default(false) @map("actions_enabled")
  lastSyncAt           DateTime? @map("last_sync_at")
  lastSyncOk           Boolean?  @map("last_sync_ok")
  lastSyncError        String?   @map("last_sync_error")
  lastFullSyncAt       DateTime? @map("last_full_sync_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  updatedById          Int?      @map("updated_by_id")
  updatedBy            User?     @relation("ItopConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("itop_config")
}

model Project {
  id                   Int              @id @default(autoincrement())
  name                 String
  description          String?
  tamId                Int              @map("tam_id")
  customerId           Int?             @map("customer_id")
  tam                  User             @relation("ProjectTAM", fields: [tamId], references: [id])
  customer             Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status               ProjectStatus    @default(PLANNING)
  // Kanban WIP limits per top-level status column. Shape:
  // {"TODO": number|null, "IN_PROGRESS": number|null, "DONE": number|null}.
  // null (or an absent key) means "no limit" for that column. Visual only —
  // the board never blocks a move when a column is over its limit, it just
  // renders the count pill in amber.
  wipLimits            Json?            @map("wip_limits") @db.JsonB
  // Administrative containers (e.g. per-TAM "Opty Timelines") stay usable as
  // projects but are excluded from portfolio roll-ups (Executive dashboard,
  // Overview, overdue monitoring) via computePortfolioRows.
  excludeFromPortfolio Boolean          @default(false) @map("exclude_from_portfolio")
  baselineLockedAt     DateTime?        @map("baseline_locked_at")
  baselineLockedById   Int?             @map("baseline_locked_by_id")
  baselineLockedBy     User?            @relation("ProjectBaselineLockedBy", fields: [baselineLockedById], references: [id])
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  tasks                Task[]
  labels               Label[]
  sections             Section[]
  epics                Epic[]
  risks                Risk[]
  taskDependencies     TaskDependency[]
  notes                ProjectNote[]
  services             ProjectService[]
  reviews              ProjectReview[]
  members              ProjectMember[]

  @@index([tamId])
  @@index([customerId])
  @@index([status])
  @@map("projects")
}

// Extra people with full access to a project alongside its TAM (visibility.ts
// projectVisibilityFilter member arm; docs/archive/plans/collaboration-and-sharing.md).
// Rows are created by the members API and by task assignment. The project's
// own TAM is never stored here. `addedById` records who added the row and is
// nulled (not cascaded) when that user is deleted.
model ProjectMember {
  projectId Int      @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById Int?     @map("added_by_id")
  addedBy   User?    @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Customer {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  accountManager    String?           @map("account_manager")
  solutionArchitect String?           @map("solution_architect")
  description       String            @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  projects          Project[]
  services          CustomerService[]
  tamId             Int?              @map("tam_id")
  tam               User?             @relation("CustomerTam", fields: [tamId], references: [id], onDelete: SetNull)
  notes             CustomerNote[]
  weeklyUpdates     WeeklyUpdate[]
  // iTop Organization this customer is mapped to (admin-mapped or exact
  // name auto-match). One customer per org.
  itopOrgId         Int?              @unique @map("itop_org_id")
  itopOrgName       String?           @map("itop_org_name")
  itopTickets       ItopTicket[]
  itopTimeEntries   ItopTimeEntry[]

  @@index([tamId])
  @@map("customers")
}

model Service {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?           @db.Text
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  customers   CustomerService[]
  projects    ProjectService[]

  @@map("services")
}

model CustomerService {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  serviceId  Int      @map("service_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tools      String[] @default([]) // free-text tool names per assignment, e.g. ["Acronis", "Veeam"]
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, serviceId])
  @@index([customerId])
  @@index([serviceId])
  @@map("customer_services")
}

model ProjectService {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  serviceId Int      @map("service_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tools     String[] @default([]) // free-text tool names per assignment, e.g. ["Acronis", "Veeam"]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, serviceId])
  @@index([projectId])
  @@index([serviceId])
  @@map("project_services")
}

model Task {
  id                Int              @id @default(autoincrement())
  projectId         Int              @map("project_id")
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId         Int?             @map("section_id")
  section           Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            TaskStatus       @default(TODO)
  priority          Priority         @default(MEDIUM)
  startDate         DateTime?        @map("start_date")
  dueDate           DateTime?        @map("due_date")
  // Explicit milestone flag. Historically derived in the frontend
  // (startDate === dueDate, or dueDate-only); backfilled once by the
  // task_is_milestone migration, user-controlled thereafter.
  isMilestone       Boolean          @default(false) @map("is_milestone")
  // Manual "if this task slips, the project end date slips" flag, set by the
  // TAM. Independent of priority; NOT computed from dependencies — the
  // computed critical path (Kahn sort + longest path) stays deferred.
  isCriticalPath    Boolean          @default(false) @map("is_critical_path")
  baselineStartDate DateTime?        @map("baseline_start_date")
  baselineDueDate   DateTime?        @map("baseline_due_date")
  assignedToId      Int?             @map("assigned_to")
  assignedTo        User?            @relation(fields: [assignedToId], references: [id])
  parentTaskId      Int?             @map("parent_task_id")
  parent            Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks          Task[]           @relation("TaskSubtasks")
  // Sibling ordering. For top-level tasks (parentTaskId null) the sibling
  // list is the project's single dense top-level order (projectId alone) —
  // ONE canonical order shared by List, Kanban, and Gantt; status does NOT
  // partition it, so a status change keeps the task's slot. For subtasks the
  // sibling list is the parent's subtask list (unchanged: also unpartitioned
  // by status). Dense 0..n-1 within a sibling list — maintained by the
  // reorder/re-parent logic in routes/tasks.ts and routes/projects.ts.
  position          Int              @default(0) @map("position")
  labels            Label[]
  comments          Comment[]
  // Dependency edges (Gantt connector arrows).
  predecessors      TaskDependency[] @relation("DependencySuccessor")
  successors        TaskDependency[] @relation("DependencyPredecessor")
  // Optional pin to one iTop ticket ref (e.g. "R-000123"), validated in
  // routes/tasks.ts. Free-form string, not an FK to ItopTicket — the ref may
  // not exist in the local snapshot yet (unmapped org, not synced, or the
  // ticket predates this integration); GET /itop/tickets/by-ref/:ref
  // resolves it against the snapshot when present. Tasks never become
  // tickets and this never writes to iTop. See
  // docs/archive/plans/itop-integration.md Task 4.2.
  /// Reverse lookup: "which task (if any) pins this ticket ref" — used by
  /// the iTop ticket panel and the task-to-ticket flow (later phases) to
  /// find a task from a ticket, the opposite direction of the by-ref
  /// endpoint above (which resolves a ref to a ticket).
  itopTicketRef     String?          @map("itop_ticket_ref")
  // Optional Jira-style Epic link — top-level tasks only. A subtask always
  // has epicId null and inherits its parent's epic for display; routes/
  // tasks.ts and routes/projects.ts enforce that (400 epic_on_subtask) and
  // re-parenting a task clears its epicId in the same transaction. Deleting
  // the epic keeps the task (SetNull), mirroring section delete. See
  // docs/archive/plans/epics-spec.md §4.
  epicId            Int?             @map("epic_id")
  epic              Epic?            @relation(fields: [epicId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sectionId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([projectId, position])
  // Backs the reverse lookup itopTicketRef documents above (ticket ref -> task).
  @@index([itopTicketRef])
  @@index([epicId])
  @@map("tasks")
}

model TaskDependency {
  id                Int            @id @default(autoincrement())
  // projectId is denormalised so the row cascades on project delete
  // and so visibility filters can scope by project without a join.
  projectId         Int            @map("project_id")
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTaskId Int            @map("predecessor_task_id")
  predecessor       Task           @relation("DependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTaskId   Int            @map("successor_task_id")
  successor         Task           @relation("DependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)
  type              DependencyType @default(HARD)
  // Network-Diagram routing hints. Capture which side of each node the
  // user dragged from/to, so the edge re-renders the same way after
  // reload. Optional: when null we default to right-source → left-target.
  sourceHandle      String?        @map("source_handle")
  targetHandle      String?        @map("target_handle")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([predecessorTaskId, successorTaskId])
  @@index([projectId])
  @@index([successorTaskId])
  @@map("task_dependencies")
}

model Section {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  // Hex color used as the phase track tint in the Network Diagram view.
  // Default neutral slate-400 keeps existing seeds visually stable.
  color     String   @default("#94a3b8")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  tasks     Task[]

  @@index([projectId])
  @@map("sections")
}

// Jira-style Epic: a named grouping of a project's top-level tasks ("stories"
// in Jira's vocabulary — Solvro keeps the Task name, see docs/plans/
// epics-spec.md §3 non-goals). Distinct from Section (a phase/track axis);
// an epic is a scope axis. Deleting an epic keeps its tasks (Task.epicId
// SetNull, mirroring section delete). Status is manual, like Jira; progress
// (done/total) is derived server-side from top-level tasks only — see
// routes/epics.ts and routes/projects.ts.
model Epic {
  id          Int        @id @default(autoincrement())
  projectId   Int        @map("project_id")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO) // reuse the enum so StatusChip works unchanged
  color       String     @default("#94a3b8") // same default as Section
  ownerId     Int?       @map("owner_id")
  owner       User?      @relation(fields: [ownerId], references: [id])
  startDate   DateTime?  @map("start_date") // manual; date contract via lib/dateBoundary.ts / z.coerce.date()
  dueDate     DateTime?  @map("due_date")
  position    Int        @default(0) // dense 0..n-1 per project
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  tasks       Task[]

  @@index([projectId])
  @@index([projectId, position])
  @@map("epics")
}

model Label {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#3aae51")
  tasks     Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model Risk {
  id              Int          @id @default(autoincrement())
  projectId       Int          @map("project_id")
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String       @db.Text
  category        RiskCategory @default(INTERNAL)
  probability     Int          @default(1)
  impact          Int          @default(1)
  status          RiskStatus   @default(OPEN)
  mitigationPlan  String?      @map("mitigation_plan") @db.Text
  contingencyPlan String?      @map("contingency_plan") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([category])
  @@map("risks")
}

// Daily Review notes — TAM logs cross-project notes per session, each
// scoped to a single project. The Internal/Customer-facing toggle is
// removed from the UI; the UI only ever writes INTERNAL. Column and default
// stay so the "INTERNAL notes never appear in exports" guardrail holds.
model ProjectNote {
  id         Int            @id @default(autoincrement())
  projectId  Int            @map("project_id")
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   Int            @map("author_id")
  author     User           @relation(fields: [authorId], references: [id])
  body       String         @db.Text
  visibility NoteVisibility @default(INTERNAL)
  noteDate   DateTime       @map("note_date") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@index([authorId])
  @@index([projectId, noteDate])
  @@map("project_notes")
}

// Operations notes — issues outside any project, scoped to a customer. The
// title is typed manually (required, 1-120 chars) rather than a service
// selector (user decision 2026-08-29, replacing the earlier service link).
// Same author-only edit / wildcard-delete rule as ProjectNote.
model CustomerNote {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   Int      @map("author_id")
  author     User     @relation(fields: [authorId], references: [id])
  noteDate   DateTime @map("note_date") @db.Date
  body       String   @db.Text
  title      String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId, noteDate])
  @@index([authorId])
  @@map("customer_notes")
}

// Weekly update per customer, drafted from that week's project + operations
// notes. NOT_STARTED is the client-side state for "no row yet" — the enum
// value exists so a saved update can be reset without deleting the row.
// Mid-week highlights (one row per highlight, each with its own risk and
// action) live in the child table WeeklyHighlight, not on this model.
// Reflection texts (outstanding issue, lesson learned, next week focus,
// manager decision) live per achievement in the child table
// WeeklyAchievement, not on this model — see WeeklyAchievement below.
model WeeklyUpdate {
  id             Int                 @id @default(autoincrement())
  customerId     Int                 @map("customer_id")
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  weekStart      DateTime            @map("week_start") @db.Date
  authorId       Int                 @map("author_id")
  author         User                @relation(fields: [authorId], references: [id])
  category       String?             @db.VarChar(120)
  highlights     WeeklyHighlight[]
  achievements   WeeklyAchievement[]
  midweekSavedAt DateTime?           @map("midweek_saved_at")
  health         WeeklyHealth?
  status         WeeklyStatus        @default(DRAFT)
  doneAt         DateTime?           @map("done_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([customerId, weekStart])
  @@index([authorId])
  @@map("weekly_updates")
}

// One Mid-week highlight — one row of Monday's table. Risk and Action live
// here, not on the week. `position` is the list order the form saved.
model WeeklyHighlight {
  id             Int          @id @default(autoincrement())
  weeklyUpdateId Int          @map("weekly_update_id")
  weeklyUpdate   WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)
  position       Int
  title          String       @db.VarChar(200)
  detail         String?      @db.Text
  risk           String?      @db.Text
  action         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([weeklyUpdateId, position])
  @@map("weekly_highlights")
}

// One Reflection achievement — one row of Monday's Reflection table. Every
// Reflection text belongs to the row; Health and Status stay on the week.
model WeeklyAchievement {
  id               Int          @id @default(autoincrement())
  weeklyUpdateId   Int          @map("weekly_update_id")
  weeklyUpdate     WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)
  position         Int
  title            String       @db.VarChar(200)
  detail           String?      @db.Text
  outstandingIssue String?      @map("outstanding_issue") @db.Text
  lessonLearned    String?      @map("lesson_learned") @db.Text
  nextWeekFocus    String?      @map("next_week_focus") @db.Text
  managerDecision  String?      @map("manager_decision") @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([weeklyUpdateId, position])
  @@map("weekly_achievements")
}

// Explicit, timestamped "reviewed this project today" mark — one per
// user/project/day (re-marking the same day is idempotent via the unique).
model ProjectReview {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewDate DateTime @map("review_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId, reviewDate])
  @@index([userId, reviewDate])
  @@map("project_reviews")
}

// Read-only snapshot of an iTop UserRequest/Incident, refreshed by the
// scheduled sync (backend/src/lib/itop/sync.ts, later task). `id` is the
// iTop object key, not a Solvro-assigned autoincrement — never generated
// here. Log columns (public/private) are added in a later phase.
model ItopTicket {
  id                Int       @id
  class             String
  ref               String    @unique
  title             String
  status            String
  operationalStatus String?   @map("operational_status")
  priority          String?
  agentPersonId     Int?      @map("agent_person_id")
  agentName         String?   @map("agent_name")
  teamName          String?   @map("team_name")
  serviceName       String?   @map("service_name")
  callerName        String?   @map("caller_name")
  orgId             Int       @map("org_id")
  customerId        Int?      @map("customer_id")
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  startDate         DateTime? @map("start_date")
  lastUpdate        DateTime  @map("last_update")
  // Escalation DEADLINES (a point in time), not the SLA stopwatch itself —
  // confirmed against a real iTop 3.2.2 install that the bare `tto`/`ttr`
  // ticket attributes are JSON integers (elapsed clock seconds), which is
  // NOT what these columns hold. Populated from iTop's
  // `tto_escalation_deadline`/`ttr_escalation_deadline` fields; null when
  // that clock isn't running. See lib/itop/sync.ts#upsertTicket and
  // lib/itop/types.ts's ITOP_TICKET_OUTPUT_FIELDS doc comment.
  tto               DateTime?
  ttr               DateTime?
  slaTtoPassed      Boolean   @default(false) @map("sla_tto_passed")
  slaTtrPassed      Boolean   @default(false) @map("sla_ttr_passed")
  resolutionDate    DateTime? @map("resolution_date")
  // Case log entries (Phase 5, backend/src/lib/itop/sync.ts). Normalised
  // JSON array `Array<{ date: string|null (ISO), author: string|null,
  // message: string }>` capped at the last 50 entries, newest last — never
  // the raw iTop `{ entries: [...] }` shape. `withLogs` on toTicketRow
  // (routes/itop.ts) gates whether these reach a response.
  publicLog         Json?     @map("public_log")
  privateLog        Json?     @map("private_log")
  syncedAt          DateTime  @map("synced_at")
  itopTimeEntries   ItopTimeEntry[]

  @@index([customerId, status])
  @@index([lastUpdate])
  @@index([agentPersonId])
  @@index([orgId])
  @@map("itop_tickets")
}

// Time-tracking snapshot rows pulled from iTop's TimeSpent (Time Tracking
// extension), refreshed by the same sync as ItopTicket
// (backend/src/lib/itop/sync.ts). `id` is the iTop object key, not a
// Solvro-assigned autoincrement. Powers the Utilization page
// (docs/archive/plans/itop-integration.md Phase 3) — hours are read only from
// TimeSpent, never a ticket's own time_spent/clock field (plan §3).
model ItopTimeEntry {
  id              Int         @id
  itopUserId      Int         @map("itop_user_id")
  userId          Int?        @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId           Int?        @map("org_id")
  customerId      Int?        @map("customer_id")
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticketId        Int?        @map("ticket_id")
  ticket          ItopTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketRef       String?     @map("ticket_ref")
  startDate       DateTime    @map("start_date")
  endDate         DateTime?   @map("end_date")
  durationMinutes Int         @map("duration_minutes")
  title           String?
  syncedAt        DateTime    @map("synced_at")

  @@index([userId, startDate])
  @@index([customerId, startDate])
  @@index([itopUserId])
  @@index([ticketId])
  @@index([startDate])
  @@map("itop_time_entries")
}
