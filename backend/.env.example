# Backend-scoped env. Prisma reads DATABASE_URL from process.env.
# Copy to backend/.env for local dev. Matches the root docker-compose Postgres defaults.

DATABASE_URL=postgresql://solvro:solvro_dev@localhost:5432/solvro?schema=public

# openssl rand -base64 32
SECRETS_KEY=

# Google OAuth is fully configurable in-app — Admin > Sign-in. No env var.
